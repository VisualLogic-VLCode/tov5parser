{
  "name": "@visuallogic-vlcode/tov5parser",
  "version": "1.2.10",
  "type": "module",
  "description": "Convert VisualLogic 4.x case JSON to 5.x case JSON. Ported from the 4.1 editor's ConvertV4ToV5.",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VisualLogic-VLCode/tov5parser.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.js",
    "lambdaIndex.js",
    "s3Transfer.js",
    "localServer.js",
    "ivxMap.txt",
    "legacyMaps/",
    "utils/",
    "v4ToV5/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test $(find . -path ./node_modules -prune -o -name \"*.test.js\" -print)",
    "test:function-local-init-corpus": "node scripts/check-function-local-init-corpus.mjs",
    "convert:local": "node scripts/convert-local-cases.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "deploy:lambda:prod": "node scripts/deploy-lambda-prod.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@jsep-plugin/arrow": "^1.0.6",
    "@jsep-plugin/new": "^1.0.4",
    "@jsep-plugin/regex": "^1.0.4",
    "@jsep-plugin/spread": "^1.0.3",
    "@jsep-plugin/template": "^1.0.5",
    "acorn": "^8.17.0",
    "astring": "^1.9.0",
    "jsep": "^1.3.9",
    "xid-js": "^1.0.1"
  },
  "bundleDependencies": true,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0"
  }
}
