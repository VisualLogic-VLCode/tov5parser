{
  "_comment": "IAM 用户 vl-case-json-converter-deployer 的权限参考（依 2026-07-08 实际探测整理，管理员按 vl-case-json-converter* 前缀授权）。与最初申请稿的差异：无 s3:CreateBucket、无 s3:ListAllMyBuckets（部署包 ~1.6MB 走直传，不需要 S3 桶）；无 iam:ListRoles/ListUserPolicies。分区 aws-cn、区域 cn-northwest-1、账号 587849590304。",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3UseProjectBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws-cn:s3:::vl-case-json-converter*",
        "arn:aws-cn:s3:::vl-case-json-converter*/*"
      ]
    },
    {
      "Sid": "IamManageLambdaRole",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:AttachRolePolicy", "iam:GetRole", "iam:ListAttachedRolePolicies"],
      "Resource": "arn:aws-cn:iam::587849590304:role/vl-case-json-converter-lambda-role"
    },
    {
      "Sid": "IamPassRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws-cn:iam::587849590304:role/vl-case-json-converter-lambda-role",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
      }
    },
    {
      "Sid": "LambdaManageFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:ListVersionsByFunction",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:GetAlias",
        "lambda:ListAliases",
        "lambda:InvokeFunction",
        "lambda:AddPermission",
        "lambda:GetPolicy"
      ],
      "Resource": [
        "arn:aws-cn:lambda:cn-northwest-1:587849590304:function:vl-case-json-converter",
        "arn:aws-cn:lambda:cn-northwest-1:587849590304:function:vl-case-json-converter:*"
      ]
    },
    {
      "Sid": "ApiGatewayManage",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws-cn:apigateway:cn-northwest-1::/*"
    },
    {
      "Sid": "LogsReadFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws-cn:logs:cn-northwest-1:587849590304:log-group:/aws/lambda/vl-case-json-converter",
        "arn:aws-cn:logs:cn-northwest-1:587849590304:log-group:/aws/lambda/vl-case-json-converter:*"
      ]
    }
  ]
}
